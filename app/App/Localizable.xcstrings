    "Stopped because files could not be saved. Free up storage, then resume.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopped because files could not be saved. Free up storage, then resume."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法儲存檔案，下載已停止。請釋出空間後再繼續。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêté : les fichiers n’ont pas pu être enregistrés. Libérez du stockage, puis reprenez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Interrotto perché non è stato possibile salvare i file. Libera spazio, poi riprendi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestoppt, weil Dateien nicht gespeichert werden konnten. Gib Speicher frei und setze dann fort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detenida porque no se pudieron guardar los archivos. Libera almacenamiento y luego reanuda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルを保存できなかったため停止しました。ストレージの空きを増やしてから再開してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일을 저장할 수 없어 중지되었습니다. 저장 공간을 확보한 후 재개하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatrzymano, bo nie udało się zapisać plików. Zwolnij miejsce i wznów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Parado porque não foi possível salvar os arquivos. Libere espaço e retome."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остановлено: не удалось сохранить файлы. Освободите место и продолжите."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存文件，下载已停止。请释放存储空间后再继续。"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Detenida porque no se pudieron guardar los archivos. Libera almacenamiento y luego reanuda."
          }
        }
      }
    },
