    "Use one of the ways below. Whichever you choose, the app checks every file before you play.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use one of the ways below. Whichever you choose, the app checks every file before you play."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez l’une des méthodes ci-dessous. Quel que soit votre choix, l’app vérifie chaque fichier avant que vous jouiez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa uno dei metodi qui sotto. Qualunque scegli, l’app controlla ogni file prima che tu giochi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutze eine der Möglichkeiten unten. Egal welche: Die App prüft jede Datei, bevor du spielst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa una de las opciones de abajo. Elijas la que elijas, la app comprueba cada archivo antes de jugar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以下のいずれかの方法を使用してください。どの方法でも、プレイ前にアプリがすべてのファイルを確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아래 방법 중 하나를 사용하세요. 어떤 방법을 선택하든 플레이 전에 앱이 모든 파일을 확인합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj jednego ze sposobów poniżej. Niezależnie od wyboru aplikacja sprawdzi każdy plik przed grą."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use uma das opções abaixo. Seja qual for, o app verifica cada arquivo antes de você jogar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите один из способов ниже. В любом случае приложение проверит каждый файл перед игрой."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请使用下列任一方式。无论选择哪种，App 都会在游玩前检查每个文件。"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa una de las opciones de abajo. Elijas la que elijas, la app verifica cada archivo antes de jugar."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請使用下列任一方式。無論選擇哪種，App 都會在開始遊戲前檢查每個檔案。"
          }
        }
      }
    },
