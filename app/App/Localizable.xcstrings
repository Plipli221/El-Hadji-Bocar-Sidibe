    "Menus change right away. The game itself switches language the next time it starts.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Menus change right away. The game itself switches language the next time it starts."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les menus changent immédiatement. Le jeu lui-même change de langue au prochain lancement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I menu cambiano subito. Il gioco cambia lingua al prossimo avvio."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Menüs wechseln sofort. Das Spiel selbst wechselt die Sprache beim nächsten Start."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los menús cambian al instante. El juego cambia de idioma la próxima vez que se inicie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューはすぐに切り替わります。ゲーム本体の言語は次回の起動時に切り替わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴는 즉시 바뀝니다. 게임 자체의 언어는 다음에 시작할 때 바뀝니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Menu zmieni się od razu. Sama gra zmieni język przy następnym uruchomieniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os menus mudam na hora. O jogo em si troca de idioma na próxima vez que iniciar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Меню меняются сразу. Сама игра сменит язык при следующем запуске."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "菜单会立即切换；游戏本身会在下次启动时切换语言。"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Los menús cambian al instante. El juego cambia de idioma la próxima vez que se inicie."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選單會立即變更；遊戲本身會在下次啟動時切換語言。"
          }
        }
      }
    },
