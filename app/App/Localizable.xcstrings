    "Tap the page's download button. The app takes the download over by itself and unpacks it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the page's download button. The app takes the download over by itself and unpacks it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez le bouton de téléchargement de la page. L’app récupère le téléchargement d’elle-même et le décompresse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca il pulsante di download della pagina. L’app prende in carico il download da sola e lo estrae."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf den Download-Button der Seite. Die App übernimmt den Download selbst und entpackt ihn."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el botón de descarga de la página. La app se encarga de la descarga y la descomprime sola."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ページのダウンロードボタンをタップしてください。アプリが自動でダウンロードを引き継ぎ、展開します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "페이지의 다운로드 버튼을 탭하세요. 앱이 자동으로 다운로드를 이어받아 압축을 해제합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij przycisk pobierania na stronie. Aplikacja sama przejmie pobieranie i rozpakuje plik."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque no botão de download da página. O app assume o download sozinho e o descompacta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите кнопку загрузки на странице. Приложение само перехватит загрузку и распакует её."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请轻点网页上的下载按钮，App 会自动接管下载并解压缩。"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el botón de descarga de la página. La app se encarga de la descarga y la descomprime sola."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請點按網頁上的下載按鈕，App 會自動接手下載並解壓縮。"
          }
        }
      }
    },
