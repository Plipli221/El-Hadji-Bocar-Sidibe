    "Not enough free space. The rest of the game needs {arg0} plus {arg1} to spare, but only {arg2} is free. Free up {arg3} and try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not enough free space. The rest of the game needs {arg0} plus {arg1} to spare, but only {arg2} is free. Free up {arg3} and try again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存空間不足。剩餘遊戲資料需要 {arg0}，並預留 {arg1}，但可用空間只有 {arg2}。請至少釋出 {arg3} 後重試。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Espace insuffisant. Le reste du jeu nécessite {arg0}, plus {arg1} de marge, mais seuls {arg2} sont libres. Libérez {arg3} et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spazio insufficiente. Il resto del gioco richiede {arg0} più {arg1} di margine, ma sono liberi solo {arg2}. Libera {arg3} e riprova."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht genug freier Speicher. Der Rest des Spiels braucht {arg0} plus {arg1} Reserve, aber nur {arg2} sind frei. Gib {arg3} frei und versuch es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay suficiente espacio libre. El resto del juego necesita {arg0} más {arg1} de margen, pero solo hay {arg2} libres. Libera {arg3} y vuelve a intentarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空き容量が足りません。残りのゲームには{arg0}と予備の{arg1}が必要ですが、空き容量は{arg2}しかありません。{arg3}以上を解放してから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여유 공간이 부족합니다. 나머지 게임에는 {arg0} 외에 여유 공간 {arg1}이(가) 더 필요하지만, 사용 가능한 공간은 {arg2}뿐입니다. {arg3}을(를) 확보한 후 다시 시도하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za mało wolnego miejsca. Reszta gry wymaga {arg0} oraz {arg1} zapasu, a wolne jest tylko {arg2}. Zwolnij {arg3} i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Espaço livre insuficiente. O restante do jogo precisa de {arg0} mais {arg1} de folga, mas só há {arg2} livres. Libere {arg3} e tente de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Недостаточно места. Для остальной части игры нужно {arg0} плюс {arg1} в запасе, а свободно только {arg2}. Освободите {arg3} и повторите попытку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存储空间不足。剩余游戏文件需要 {arg0}，并需预留 {arg1}，但可用空间只有 {arg2}。请至少释放 {arg3} 后重试。"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay suficiente espacio libre. El resto del juego necesita {arg0} más {arg1} de margen, pero solo hay {arg2} libres. Libera {arg3} y vuelve a intentarlo."
          }
        }
      }
    },
