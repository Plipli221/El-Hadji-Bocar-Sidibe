          }
        }
      }
    },
    " Presets above the recommended one can run out of memory or overheat on this phone; if a launch fails, the game falls back automatically.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " Presets above the recommended one can run out of memory or overheat on this phone; if a launch fails, the game falls back automatically."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": " 高於建議的畫質可能導致記憶體不足或裝置過熱；若無法啟動，將自動降低設定。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " Les préréglages au-dessus de celui recommandé peuvent manquer de mémoire ou faire chauffer ce téléphone ; si un lancement échoue, le jeu revient automatiquement en arrière."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": " I preset superiori a quello consigliato possono esaurire la memoria o surriscaldare questo telefono; se un avvio non riesce, il gioco torna indietro automaticamente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " Voreinstellungen über der empfohlenen können auf diesem Telefon den Speicher überlasten oder überhitzen; schlägt ein Start fehl, wechselt das Spiel automatisch zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " Los preajustes por encima del recomendado pueden quedarse sin memoria o sobrecalentar este móvil; si falla un inicio, el juego vuelve a uno inferior automáticamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": " 推奨より上のプリセットは、このiPhoneでメモリ不足や過熱を起こす可能性があります。起動に失敗した場合、ゲームは自動的に設定を下げます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": " 권장 프리셋보다 높은 프리셋은 이 iPhone에서 메모리가 부족하거나 과열될 수 있습니다. 실행에 실패하면 게임이 자동으로 설정을 낮춥니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": " Ustawienia wyższe niż zalecane mogą wyczerpać pamięć lub przegrzać ten telefon; jeśli uruchomienie się nie powiedzie, gra automatycznie wróci do niższego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": " Predefinições acima da recomendada podem ficar sem memória ou superaquecer neste celular; se a inicialização falhar, o jogo volta automaticamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": " Пресеты выше рекомендованного могут исчерпать память или перегреть этот телефон; если запуск не удастся, игра автоматически откатится."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": " 高于建议档位的预设可能导致内存不足或设备过热；如果启动失败，游戏会自动降低设置。"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": " Los preajustes por encima del recomendado pueden quedarse sin memoria o sobrecalentar este teléfono; si falla un inicio, el juego vuelve a uno inferior automáticamente."
          }
        }
      }
    },
    " Removing files also clears the startup set; the next Play prepares it again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " Removing files also clears the startup set; the next Play prepares it again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": " 刪除檔案也會清除啟動所需的快取；下次遊玩時會重新準備。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " Supprimer les fichiers efface aussi le lot de démarrage ; le prochain Jouer le prépare à nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": " Eliminare i file cancella anche il set di avvio; al prossimo Gioca verrà preparato di nuovo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " Das Entfernen der Dateien löscht auch die Startdaten; beim nächsten Spielen werden sie neu vorbereitet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " Eliminar los archivos también borra el conjunto de inicio; se volverá a preparar la próxima vez que pulses Jugar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": " ファイルを削除すると起動用のデータも消去されます。次回の「プレイ」で再び準備されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": " 파일을 삭제하면 시작용 데이터도 지워지며, 다음에 ‘플레이’할 때 다시 준비됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": " Usunięcie plików czyści też dane startowe; przy następnym Graj zostaną przygotowane ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": " Remover os arquivos também limpa o conjunto de inicialização; o próximo Jogar o prepara de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": " Удаление файлов также очищает стартовый набор; при следующем нажатии «Играть» он будет подготовлен заново."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": " 删除文件也会清除启动所需的缓存；下次游玩时会重新准备。"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": " Eliminar los archivos también borra el conjunto de inicio; se volverá a preparar la próxima vez que toques Jugar."
          }
        }
      }
    },
