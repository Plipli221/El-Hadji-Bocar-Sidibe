    "The campaign with missions. Continues your latest save, or starts from the Prologue.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The campaign with missions. Continues your latest save, or starts from the Prologue."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "遊玩完整劇情與任務，繼續上次存檔，或從序章開始。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La campagne avec les missions. Reprend votre dernière sauvegarde, ou démarre au prologue."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La campagna con le missioni. Continua dall’ultimo salvataggio o parte dal Prologo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kampagne mit Missionen. Setzt deinen letzten Spielstand fort oder beginnt mit dem Prolog."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La campaña con misiones. Continúa tu última partida guardada o empieza desde el Prólogo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ミッションのあるキャンペーン。最新のセーブから続けるか、プロローグから始めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미션이 있는 캠페인입니다. 최근 저장 데이터에서 이어서 하거나 프롤로그부터 시작합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kampania z misjami. Wczytuje ostatni zapis albo zaczyna od prologu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A campanha com missões. Continua seu último jogo salvo ou começa pelo Prólogo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кампания с миссиями. Продолжает последнее сохранение или начинается с пролога."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "游玩完整剧情与任务。继续上次存档，或从序章开始。"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "La campaña con misiones. Continúa tu última partida guardada o empieza desde el Prólogo."
          }
        }
      }
