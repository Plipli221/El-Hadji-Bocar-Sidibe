        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게임 파일이 이미 이 iPhone에 있으므로(폴더 ‘{arg0}’) 다운로드할 필요가 없습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pliki gry są już na tym iPhonie (folder „{arg0}”), więc nie trzeba niczego pobierać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os arquivos do jogo já estão neste iPhone (pasta \"{arg0}\"), então não é preciso baixar nada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлы игры уже есть на этом iPhone (папка «{arg0}»), загружать ничего не нужно."
          }
