    "\n⚠︎ Heavier than this phone's recommended setting: may run out of memory or overheat.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\n⚠︎ Heavier than this phone's recommended setting: may run out of memory or overheat."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\n⚠︎ 高於此裝置的建議設定，可能記憶體不足或過熱。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\n⚠︎ Plus lourd que le réglage recommandé pour ce téléphone : risque de manquer de mémoire ou de chauffer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "\n⚠︎ Più pesante dell’impostazione consigliata per questo telefono: potrebbe esaurire la memoria o surriscaldarsi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\n⚠︎ Anspruchsvoller als die empfohlene Einstellung für dieses Telefon: Speicher kann ausgehen oder das Telefon überhitzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\n⚠︎ Más exigente que el ajuste recomendado para este móvil: puede quedarse sin memoria o sobrecalentarse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\n⚠︎ このiPhoneの推奨設定より重いため、メモリ不足や過熱が起きる可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\n⚠︎ 이 iPhone의 권장 설정보다 무거워 메모리가 부족하거나 과열될 수 있습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "\n⚠︎ Bardziej wymagające niż zalecane ustawienie dla tego telefonu: może zabraknąć pamięci lub telefon może się przegrzać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "\n⚠︎ Mais pesado que a configuração recomendada para este celular: pode ficar sem memória ou superaquecer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\n⚠︎ Тяжелее рекомендованной настройки для этого телефона: может не хватить памяти или телефон перегреется."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\n⚠︎ 高于此 iPhone 的推荐设置，可能导致内存不足或过热。"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "\n⚠︎ Más exigente que la configuración recomendada para este teléfono: puede quedarse sin memoria o sobrecalentarse."
          }
        }
      }
    },
