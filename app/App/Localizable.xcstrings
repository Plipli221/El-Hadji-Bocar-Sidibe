    "Use the page's download button in the browser; the app takes over the download.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the page's download button in the browser; the app takes over the download."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez le bouton de téléchargement de la page dans le navigateur ; l’app prend le relais du téléchargement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa il pulsante di download della pagina nel browser; l’app prende in carico il download."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutze den Download-Button der Seite im Browser; die App übernimmt den Download."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa el botón de descarga de la página en el navegador; la app se encarga de la descarga."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブラウザでページのダウンロードボタンを使ってください。アプリがダウンロードを引き継ぎます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "브라우저에서 페이지의 다운로드 버튼을 사용하세요. 앱이 다운로드를 이어받습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj przycisku pobierania na stronie w przeglądarce; aplikacja przejmie pobieranie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use o botão de download da página no navegador; o app assume o download."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите кнопку загрузки на странице в браузере, и приложение перехватит загрузку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在浏览器中轻点网页上的下载按钮，App 会接管下载。"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa el botón de descarga de la página en el navegador; la app se encarga de la descarga."
          }
