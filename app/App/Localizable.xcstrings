    "Sends this run's game log and the previous one: your iPhone model, iOS version, app settings and what the game printed. No personal data, photos or contacts.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sends this run's game log and the previous one: your iPhone model, iOS version, app settings and what the game printed. No personal data, photos or contacts."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將傳送本次與前次遊戲紀錄，包含 iPhone 型號、iOS 版本、App 設定和遊戲輸出，不包含相片或聯絡人。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoie le journal de cette session et celui de la précédente : modèle d’iPhone, version d’iOS, réglages de l’app et ce que le jeu a affiché. Aucune donnée personnelle, photo ni contact."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invia il registro di gioco di questa sessione e di quella precedente: modello di iPhone, versione di iOS, impostazioni dell’app e ciò che il gioco ha stampato. Nessun dato personale, foto o contatto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendet das Spielprotokoll dieser und der vorherigen Sitzung: dein iPhone-Modell, die iOS-Version, App-Einstellungen und die Ausgaben des Spiels. Keine persönlichen Daten, Fotos oder Kontakte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía el registro del juego de esta sesión y de la anterior: el modelo de tu iPhone, la versión de iOS, los ajustes de la app y lo que mostró el juego. Sin datos personales, fotos ni contactos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今回と前回のゲームログを送信します。内容はiPhoneのモデル、iOSバージョン、アプリの設定、ゲームの出力です。個人データ、写真、連絡先は含まれません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 실행과 이전 실행의 게임 로그를 보냅니다. iPhone 모델, iOS 버전, 앱 설정, 게임 출력 내용이 포함되며 개인 데이터, 사진, 연락처는 포함되지 않습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wysyła dziennik gry z tej i poprzedniej sesji: model iPhone’a, wersję iOS, ustawienia aplikacji i komunikaty gry. Bez danych osobowych, zdjęć i kontaktów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Envia o registro do jogo desta sessão e o da anterior: modelo do iPhone, versão do iOS, configurações do app e o que o jogo exibiu. Nenhum dado pessoal, foto ou contato."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправляет журнал игры за этот и предыдущий запуск: модель iPhone, версию iOS, настройки приложения и вывод игры. Никаких личных данных, фото или контактов."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将发送本次和上次的游戏日志，包括 iPhone 型号、iOS 版本、App 设置和游戏输出。不含个人数据、照片或联系人。"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía el registro del juego de esta sesión y de la anterior: el modelo de tu iPhone, la versión de iOS, la configuración de la app y lo que mostró el juego. Sin datos personales, fotos ni contactos."
          }
        }
      }
    },
