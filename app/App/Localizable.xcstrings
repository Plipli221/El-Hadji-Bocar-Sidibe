    "The app was not allowed to open that folder. Move your game folder to Files › On My iPhone › GTA V Port instead; the app finds it there by itself.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app was not allowed to open that folder. Move your game folder to Files › On My iPhone › GTA V Port instead; the app finds it there by itself."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 沒有權限讀取此資料夾。請改移到「檔案 › 我的 iPhone › GTA V Port」，App 便能自動偵測。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app n’a pas été autorisée à ouvrir ce dossier. Déplacez plutôt le dossier du jeu dans Fichiers › Sur mon iPhone › GTA V Port ; l’app l’y trouve d’elle-même."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app non ha il permesso di aprire quella cartella. Sposta invece la cartella del gioco in File › Su iPhone › GTA V Port; l’app la trova da sola."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App durfte diesen Ordner nicht öffnen. Verschiebe deinen Spielordner stattdessen nach Dateien › Auf meinem iPhone › GTA V Port; die App findet ihn dort von selbst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app no tiene permiso para abrir esa carpeta. Mejor mueve la carpeta del juego a Archivos › En mi iPhone › GTA V Port; la app la encontrará ahí sola."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリにそのフォルダを開く許可がありませんでした。代わりに、ゲームフォルダを「ファイル › このiPhone内 › GTA V Port」に移動してください。そこならアプリが自動で見つけます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱에 해당 폴더를 열 수 있는 권한이 없습니다. 대신 게임 폴더를 ‘파일 › 나의 iPhone › GTA V Port’로 옮기세요. 그곳에 있으면 앱이 자동으로 찾습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacja nie otrzymała dostępu do tego folderu. Przenieś folder gry do Pliki › Na moim iPhonie › GTA V Port; aplikacja sama go tam znajdzie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O app não teve permissão para abrir essa pasta. Em vez disso, mova a pasta do jogo para Arquivos › No Meu iPhone › GTA V Port; o app a encontra lá sozinho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложению не разрешили открыть эту папку. Вместо этого переместите папку игры в Файлы › На iPhone › GTA V Port: там приложение найдёт её само."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App 没有权限访问此文件夹。请改为将游戏文件夹移到“文件 › 我的 iPhone › GTA V Port”，App 会自动找到。"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "La app no tiene permiso para abrir esa carpeta. Mejor mueve la carpeta del juego a Archivos › En mi iPhone › GTA V Port; la app la encontrará ahí sola."
          }
        }
      }
    },
