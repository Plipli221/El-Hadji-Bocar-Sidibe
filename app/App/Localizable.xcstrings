          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über einen Link"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desde un enlace"
          }
        },
        "ja": {
          "stringUnit": {
