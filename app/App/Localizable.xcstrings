    "Preset and frame rate changes apply the next time you start the game.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preset and frame rate changes apply the next time you start the game."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "畫質預設與幀率會在下次啟動遊戲時生效。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les changements de préréglage et de fréquence d’images s’appliquent au prochain lancement du jeu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modifiche al preset e alla frequenza fotogrammi si applicano al prossimo avvio del gioco."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Änderungen an Voreinstellung und Bildrate gelten beim nächsten Spielstart."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cambios de preajuste y de fotogramas por segundo se aplican la próxima vez que inicies el juego."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プリセットとフレームレートの変更は、次回ゲームを起動したときに適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프리셋 및 프레임 속도 변경 사항은 다음에 게임을 시작할 때 적용됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmiany ustawień wstępnych i liczby klatek zostaną zastosowane przy następnym uruchomieniu gry."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As mudanças de predefinição e taxa de quadros valem na próxima vez que você iniciar o jogo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пресет и частота кадров изменятся при следующем запуске игры."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "画质预设与帧率更改将在下次启动游戏时生效。"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cambios de preajuste y de fotogramas por segundo se aplican la próxima vez que inicies el juego."
          }
        }
      }
    },
    "Presets apply when you press Play.": {
      "extractionState": "manual",
      "localizations": {
