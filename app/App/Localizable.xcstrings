    "{arg0} answers with the game's file list. The game reads its files from there while you play.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "{arg0} answers with the game's file list. The game reads its files from there while you play."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "{arg0} répond avec la liste des fichiers du jeu. Le jeu y lit ses fichiers pendant que vous jouez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "{arg0} risponde con l’elenco dei file del gioco. Il gioco legge i file da lì mentre giochi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "{arg0} antwortet mit der Dateiliste des Spiels. Das Spiel liest seine Dateien beim Spielen von dort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "{arg0} responde con la lista de archivos del juego. El juego leerá sus archivos desde ahí mientras juegas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "{arg0}からゲームのファイル一覧が返されました。プレイ中、ゲームはそこからファイルを読み込みます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "{arg0}에서 게임 파일 목록을 응답했습니다. 플레이하는 동안 게임이 그곳에서 파일을 읽습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "{arg0} odpowiada listą plików gry. Podczas gry pliki będą odczytywane stamtąd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "{arg0} responde com a lista de arquivos do jogo. O jogo lê os arquivos de lá enquanto você joga."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "{arg0} отдаёт список файлов игры. Во время игры файлы будут читаться оттуда."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "{arg0} 返回了游戏文件列表。游玩时，游戏会从那里读取文件。"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "{arg0} responde con la lista de archivos del juego. El juego leerá sus archivos desde ahí mientras juegas."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "{arg0} 回傳了遊戲檔案清單。遊玩時，遊戲會從那裡讀取檔案。"
          }
        }
      }
    },
