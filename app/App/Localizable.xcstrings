    ". That usually means this setting needs more memory than iOS gives the app on this iPhone (about {arg0} MB).": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": ". That usually means this setting needs more memory than iOS gives the app on this iPhone (about {arg0} MB)."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "。這通常代表目前設定超過 iOS 分配給 App 的記憶體上限（約 {arg0} MB）。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": ". Cela signifie généralement que ce réglage demande plus de mémoire que ce qu’iOS accorde à l’app sur cet iPhone (environ {arg0} Mo)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": ". Di solito significa che questa impostazione richiede più memoria di quella che iOS concede all’app su questo iPhone (circa {arg0} MB)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": ". Das bedeutet meist, dass diese Einstellung mehr Speicher braucht, als iOS der App auf diesem iPhone gibt (etwa {arg0} MB)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": ". Eso suele significar que este ajuste necesita más memoria de la que iOS da a la app en este iPhone (unos {arg0} MB)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "。通常、この設定にはiOSがこのiPhoneでアプリに割り当てるメモリ（約{arg0} MB）より多くのメモリが必要であることを意味します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ". 이는 보통 이 설정에 iOS가 이 iPhone에서 앱에 허용하는 메모리(약 {arg0} MB)보다 많은 메모리가 필요하다는 뜻입니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": ". Zwykle oznacza to, że to ustawienie wymaga więcej pamięci, niż iOS przydziela aplikacji na tym iPhonie (ok. {arg0} MB)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": ". Isso geralmente significa que essa configuração precisa de mais memória do que o iOS dá ao app neste iPhone (cerca de {arg0} MB)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": ". Обычно это значит, что этой настройке нужно больше памяти, чем iOS выделяет приложению на этом iPhone (около {arg0} МБ)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "。这通常表示此设置所需内存超过了 iOS 在此 iPhone 上分配给 App 的上限（约 {arg0} MB）。"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": ". Eso suele significar que esta configuración necesita más memoria de la que iOS le da a la app en este iPhone (unos {arg0} MB)."
          }
        }
      }
    },
