    "No internet connection? Try again, or use Share log instead.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No internet connection? Try again, or use Share log instead."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請確認網路連線，或改用「分享紀錄」。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de connexion Internet ? Réessayez, ou utilisez plutôt Partager le journal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna connessione a Internet? Riprova, oppure usa Condividi registro."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Internetverbindung? Versuch es erneut oder nutze stattdessen Protokoll teilen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Sin conexión a internet? Vuelve a intentarlo o usa Compartir registro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インターネットに接続されていませんか？もう一度お試しいただくか、代わりに「ログを共有」を使ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인터넷에 연결되어 있지 않나요? 다시 시도하거나 대신 ‘로그 공유’를 사용하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak połączenia z internetem? Spróbuj ponownie lub użyj opcji Udostępnij dziennik."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem conexão com a internet? Tente de novo ou use Compartilhar registro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет интернета? Повторите попытку или используйте «Поделиться журналом»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查网络连接后重试，或改用“分享日志”。"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Sin conexión a internet? Vuelve a intentarlo o usa Compartir registro."
          }
        }
      }
    },
