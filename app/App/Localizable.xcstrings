    "You opened the \"{arg0}\" folder. Go back up one or two levels and pick the folder that has both \"data\" and \"b\" inside, then tap Open there.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You opened the \"{arg0}\" folder. Go back up one or two levels and pick the folder that has both \"data\" and \"b\" inside, then tap Open there."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你開啟的是「{arg0}」資料夾。請返回上一層或上兩層，選擇同時包含「data」和「b」的資料夾，再按「開啟」。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez ouvert le dossier « {arg0} ». Remontez d’un ou deux niveaux, choisissez le dossier qui contient à la fois « data » et « b », puis touchez Ouvrir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai aperto la cartella “{arg0}”. Torna su di uno o due livelli e scegli la cartella che contiene sia “data” sia “b”, poi tocca Apri."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast den Ordner „{arg0}“ geöffnet. Geh eine oder zwei Ebenen zurück, wähle den Ordner, der sowohl „data“ als auch „b“ enthält, und tippe dort auf Öffnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has abierto la carpeta \"{arg0}\". Sube uno o dos niveles, elige la carpeta que contiene \"data\" y \"b\" y toca Abrir ahí."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「{arg0}」フォルダを開いています。1〜2階層上に戻り、「data」と「b」の両方が入っているフォルダを選んで、そこで「開く」をタップしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘{arg0}’ 폴더를 열었습니다. 한두 단계 위로 돌아가서 ‘data’와 ‘b’가 모두 들어 있는 폴더를 선택한 다음 그곳에서 ‘열기’를 탭하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwarto folder „{arg0}”. Wróć o jeden lub dwa poziomy wyżej, wybierz folder zawierający zarówno „data”, jak i „b”, i stuknij tam Otwórz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você abriu a pasta \"{arg0}\". Volte um ou dois níveis e escolha a pasta que tem \"data\" e \"b\" dentro, depois toque em Abrir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы открыли папку «{arg0}». Поднимитесь на один-два уровня выше, выберите папку, в которой есть и «data», и «b», и нажмите там «Открыть»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你打开的是“{arg0}”文件夹。请返回上一层或上两层，选择同时包含“data”和“b”的文件夹，然后轻点“打开”。"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Abriste la carpeta \"{arg0}\". Sube uno o dos niveles, elige la carpeta que contiene \"data\" y \"b\" y toca Abrir ahí."
          }
        }
      }
    },
