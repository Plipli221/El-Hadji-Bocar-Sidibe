    "The most memory the game may use. Lower it if the game closes on its own. Applies when you press Play.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The most memory the game may use. Lower it if the game closes on its own. Applies when you press Play."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der meiste Speicher, den das Spiel nutzen darf. Senke ihn, wenn sich das Spiel von selbst schließt. Gilt beim Tippen auf „Spielen“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La memoria máxima que puede usar el juego. Bájala si el juego se cierra solo. Se aplica al pulsar Jugar."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "La memoria máxima que puede usar el juego. Bájala si el juego se cierra solo. Se aplica al presionar Jugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La mémoire maximale que le jeu peut utiliser. Baissez-la si le jeu se ferme tout seul. S'applique quand vous appuyez sur Jouer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La memoria massima che il gioco può usare. Abbassala se il gioco si chiude da solo. Si applica quando premi Gioca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゲームが使えるメモリの上限です。ゲームが勝手に終了する場合は下げてください。プレイを押したときに適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게임이 사용할 수 있는 최대 메모리입니다. 게임이 저절로 꺼지면 낮추세요. 플레이를 누를 때 적용됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najwięcej pamięci, ile gra może użyć. Zmniejsz, jeśli gra sama się zamyka. Działa po naciśnięciu Graj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A memória máxima que o jogo pode usar. Diminua se o jogo fechar sozinho. Vale quando você toca em Jogar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Наибольший объём памяти, который может использовать игра. Уменьшите, если игра закрывается сама. Применяется при нажатии «Играть»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "游戏最多可使用的内存。如果游戏自行关闭，请调低。按下“开始游戏”时生效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "遊戲最多可使用的記憶體。如果遊戲自行關閉，請調低。按下「開始遊戲」時生效。"
          }
        }
      }
    },
