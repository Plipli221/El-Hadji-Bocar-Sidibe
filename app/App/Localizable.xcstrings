    "Downloading and unpacking. Keep the app open; progress is shown below.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloading and unpacking. Keep the app open; progress is shown below."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Téléchargement et décompression. Gardez l’app ouverte ; la progression s’affiche ci-dessous."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Download ed estrazione in corso. Tieni l’app aperta; l’avanzamento è mostrato qui sotto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird heruntergeladen und entpackt. Lass die App geöffnet; der Fortschritt wird unten angezeigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descargando y descomprimiendo. Mantén la app abierta; el progreso se muestra abajo."
