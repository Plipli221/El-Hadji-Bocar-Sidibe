          }
        }
      }
    },
    "The game folder was moved or deleted. Put it back in Files › On My iPhone › GTA V Port, or pick it again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The game folder was moved or deleted. Put it back in Files › On My iPhone › GTA V Port, or pick it again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "遊戲資料夾可能已移動或刪除。請將它移回「檔案 › 我的 iPhone › GTA V Port」，或重新選取資料夾。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dossier du jeu a été déplacé ou supprimé. Remettez-le dans Fichiers › Sur mon iPhone › GTA V Port, ou choisissez-le à nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cartella del gioco è stata spostata o eliminata. Rimettila in File › Su iPhone › GTA V Port, oppure sceglila di nuovo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Spielordner wurde verschoben oder gelöscht. Leg ihn zurück nach Dateien › Auf meinem iPhone › GTA V Port oder wähle ihn erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La carpeta del juego se ha movido o eliminado. Vuelve a ponerla en Archivos › En mi iPhone › GTA V Port o elígela de nuevo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゲームフォルダが移動または削除されました。「ファイル › このiPhone内 › GTA V Port」に戻すか、もう一度選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게임 폴더가 이동되었거나 삭제되었습니다. ‘파일 › 나의 iPhone › GTA V Port’로 다시 옮기거나 폴더를 다시 선택하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Folder gry został przeniesiony lub usunięty. Umieść go z powrotem w Pliki › Na moim iPhonie › GTA V Port lub wybierz go ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A pasta do jogo foi movida ou apagada. Coloque-a de volta em Arquivos › No Meu iPhone › GTA V Port ou escolha-a de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Папка игры перемещена или удалена. Верните её в Файлы › На iPhone › GTA V Port или выберите заново."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "游戏文件夹可能已被移动或删除。请将它移回“文件 › 我的 iPhone › GTA V Port”，或重新选择文件夹。"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "La carpeta del juego se movió o se eliminó. Vuelve a ponerla en Archivos › En mi iPhone › GTA V Port o elígela de nuevo."
          }
        }
      }
    },
    "The game reads everything from this iPhone. Removing the files frees the space; the game then streams again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The game reads everything from this iPhone. Removing the files frees the space; the game then streams again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "遊戲會直接讀取手機上的資料；刪除後可騰出空間，但之後必須重新使用串流。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le jeu lit tout depuis cet iPhone. Supprimer les fichiers libère l’espace ; le jeu repasse alors en diffusion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il gioco legge tutto da questo iPhone. Eliminando i file liberi lo spazio; il gioco torna allo streaming."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Spiel liest alles von diesem iPhone. Das Entfernen der Dateien gibt den Speicher frei; danach streamt das Spiel wieder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El juego lee todo desde este iPhone. Al eliminar los archivos se libera el espacio y el juego vuelve a usar streaming."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゲームはすべてこのiPhoneから読み込みます。ファイルを削除すると空き容量が増え、ゲームは再びストリーミングになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게임이 모든 데이터를 이 iPhone에서 읽습니다. 파일을 삭제하면 공간이 확보되고, 게임은 다시 스트리밍됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gra odczytuje wszystko z tego iPhone’a. Usunięcie plików zwolni miejsce; gra będzie wtedy znów strumieniować."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O jogo lê tudo deste iPhone. Remover os arquivos libera o espaço; depois o jogo volta a usar streaming."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Игра читает всё с этого iPhone. Удаление файлов освободит место, и игра снова будет загружать их по сети."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "游戏会直接读取此 iPhone 上的文件。删除文件可释放空间，之后游戏将重新使用串流。"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "El juego lee todo desde este iPhone. Al eliminar los archivos se libera el espacio y el juego vuelve a usar streaming."
          }
        }
      }
    },
    "The simulator reads the Mac's game files directly. Launch with --stream-assets to test downloads.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The simulator reads the Mac's game files directly. Launch with --stream-assets to test downloads."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "模擬器會直接讀取 Mac 上的遊戲檔案。如要測試下載，請使用 --stream-assets 啟動。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le simulateur lit directement les fichiers du jeu du Mac. Lancez avec --stream-assets pour tester les téléchargements."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il simulatore legge direttamente i file di gioco del Mac. Avvia con --stream-assets per provare i download."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Simulator liest die Spieldateien direkt vom Mac. Starte mit --stream-assets, um Downloads zu testen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El simulador lee directamente los archivos del juego del Mac. Inícialo con --stream-assets para probar las descargas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シミュレータはMacのゲームファイルを直接読み込みます。ダウンロードをテストするには --stream-assets を付けて起動してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시뮬레이터는 Mac의 게임 파일을 직접 읽습니다. 다운로드를 테스트하려면 --stream-assets 옵션으로 실행하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Symulator odczytuje pliki gry bezpośrednio z Maca. Aby przetestować pobieranie, uruchom z --stream-assets."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O simulador lê os arquivos do jogo direto do Mac. Inicie com --stream-assets para testar downloads."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Симулятор читает файлы игры прямо с Mac. Запустите с --stream-assets, чтобы проверить загрузку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模拟器会直接读取 Mac 上的游戏文件。如需测试下载，请使用 --stream-assets 启动。"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "El simulador lee directamente los archivos del juego de la Mac. Inícialo con --stream-assets para probar las descargas."
          }
        }
      }
    },
