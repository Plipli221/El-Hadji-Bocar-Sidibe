    "Could not reach the game server. Check that Tailscale is connected, then resume.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not reach the game server. Check that Tailscale is connected, then resume."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法連上遊戲伺服器。請確認 Tailscale 已連線，再繼續下載。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de joindre le serveur du jeu. Vérifiez que Tailscale est connecté, puis reprenez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile raggiungere il server di gioco. Controlla che Tailscale sia connesso, poi riprendi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Spielserver ist nicht erreichbar. Prüfe, ob Tailscale verbunden ist, und setze dann fort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo conectar con el servidor del juego. Comprueba que Tailscale esté conectado y luego reanuda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゲームサーバーに接続できませんでした。Tailscaleが接続されていることを確認してから再開してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게임 서버에 연결할 수 없습니다. Tailscale이 연결되어 있는지 확인한 후 재개하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można połączyć się z serwerem gry. Sprawdź, czy Tailscale jest połączony, i wznów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível acessar o servidor do jogo. Verifique se o Tailscale está conectado e retome."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось связаться с сервером игры. Убедитесь, что Tailscale подключён, и продолжите."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接游戏服务器。请确认 Tailscale 已连接，再继续下载。"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo conectar con el servidor del juego. Verifica que Tailscale esté conectado y luego reanuda."
          }
        }
      }
    },
