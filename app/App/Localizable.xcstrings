    "Story mode saves stay on this phone between launches. Sandbox keeps its own separate files.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Story mode saves stay on this phone between launches. Sandbox keeps its own separate files."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "劇情存檔會保留在這支手機；沙盒模式使用獨立的存檔。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sauvegardes du Mode histoire restent sur ce téléphone d’un lancement à l’autre. Le Bac à sable garde ses propres fichiers."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I salvataggi della Modalità storia restano su questo telefono tra un avvio e l’altro. Sandbox ha i suoi file separati."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spielstände im Story-Modus bleiben zwischen den Starts auf diesem Telefon. Sandbox hat eigene, separate Dateien."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las partidas del Modo historia se guardan en este móvil entre sesiones. Sandbox tiene sus propios archivos aparte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストーリーモードのセーブデータは、起動し直してもこのiPhoneに残ります。サンドボックスは別のファイルを使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스토리 모드 저장 데이터는 앱을 다시 실행해도 이 iPhone에 유지됩니다. 샌드박스는 별도의 파일을 사용합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisy Trybu fabularnego zostają na tym telefonie między uruchomieniami. Piaskownica ma własne, osobne pliki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os jogos salvos do Modo história ficam neste celular entre as sessões. O Sandbox mantém seus próprios arquivos separados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранения сюжетного режима остаются на этом телефоне между запусками. У песочницы свои отдельные файлы."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "剧情模式存档会保留在此 iPhone 上；沙盒模式使用独立的存档。"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Las partidas del Modo historia se guardan en este teléfono entre sesiones. Sandbox tiene sus propios archivos aparte."
          }
        }
      }
    },
