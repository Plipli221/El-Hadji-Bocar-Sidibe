    " Close and reopen the app to play {arg0}.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " Close and reopen the app to play {arg0}."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": " 關閉再重新開啟 App，即可進入 {arg0}。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " Fermez et rouvrez l’app pour jouer en {arg0}."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": " Chiudi e riapri l’app per giocare con {arg0}."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " Schließe die App und öffne sie erneut, um {arg0} zu spielen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " Cierra y vuelve a abrir la app para jugar en {arg0}."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
