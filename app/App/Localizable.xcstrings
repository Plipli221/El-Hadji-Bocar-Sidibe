    "About 5 minutes. Tap again to refresh. You can still wreck the car.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About 5 minutes. Tap again to refresh. You can still wreck the car."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Etwa 5 Minuten. Erneut tippen zum Auffrischen. Das Auto kann trotzdem kaputtgehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Unos 5 minutos. Vuelve a tocar para renovarlo. El coche aún puede destrozarse."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Unos 5 minutos. Vuelve a tocar para renovarlo. El auto aún puede destrozarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Environ 5 minutes. Touchez à nouveau pour renouveler. La voiture peut toujours être détruite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Circa 5 minuti. Tocca di nuovo per rinnovarla. L'auto può comunque distruggersi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "約5分間。もう一度タップで延長。車は壊れることがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "약 5분. 다시 탭하면 연장됩니다. 차는 여전히 부서질 수 있습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Około 5 minut. Stuknij ponownie, aby odnowić. Samochód nadal można rozbić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca de 5 minutos. Toque de novo para renovar. O carro ainda pode ser destruído."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Около 5 минут. Нажмите ещё раз, чтобы продлить. Машину всё равно можно разбить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "约 5 分钟。再次点按可续时。车辆仍可能被毁。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "約 5 分鐘。再次點按可延長。車輛仍可能被毀。"
          }
        }
      }
    },
